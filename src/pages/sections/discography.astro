---
import AlbumCard from "@/components/albumCard.astro";

// Import images for the discography section
const albums = import.meta.glob("../../assets/discography/*.png", {
    eager: true,
    query: "?url",
});

const albumsUrl = [
    {
        title: "469",
        redirect:
            "https://open.spotify.com/intl-es/album/5yI1IEnEUGYY5XDmtoWlrl",
    },
    {
        title: "ardiente_deseo",
        redirect:
            "https://open.spotify.com/intl-es/album/7CMMAkhoElhzZ28vt5XO5w",
    },
    {
        title: "contempla_más_allá_de_mi_carne",
        redirect:
            "https://open.spotify.com/intl-es/album/02zIc3YetVew50gAGJOe4u",
    },
    {
        title: "cuánto_vale_el_mundo_sin_ti",
        redirect:
            "https://open.spotify.com/intl-es/album/2Yxf0lX1h3APH9gKMuPPQp",
    },
    {
        title: "peligros_y_jazmines",
        redirect:
            "https://open.spotify.com/intl-es/track/0dDPHuII3u35L7TNtfwHlw",
    },
    {
        title: "tu_y_yo",
        redirect:
            "https://open.spotify.com/intl-es/album/3OSGfFRhHu2Rm1uccUbEut",
    },
];
---

<section id="discografia" class="discography-section">
    <h2 class="section-title">DISCOGRAFIA</h2>
    <div class="cards-container">
        {
            Object.entries(albums).map(([path, url]) => {
                const fileName = path.split("/").pop()?.replace(".png", "");
                const album = albumsUrl.find(
                    (album) => album.title === fileName,
                );
                return (
                    <AlbumCard
                        href={album?.redirect || "#"}
                        src={url.default}
                        alt={fileName || "Album"}
                        title={
                            fileName?.replaceAll("_", " ").toUpperCase() ||
                            "ALBUM"
                        }
                    />
                );
            })
        }
    </div>
</section>

<style>
    .discography-section {
        padding: 4rem 2rem;
        background-color: #181823;
    }

    .cards-container {
        padding-top: 2rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 2rem;
        justify-items: center;
    }
</style>
